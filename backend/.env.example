# Shared by Windows Django and WSL Celery; localhost reaches WSL services from Windows.
# Replace this development password after creating the catalog role.
DATABASE_URL=postgresql://catalog:change-me-local@127.0.0.1:5432/catalog
REDIS_URL=redis://127.0.0.1:6379/0
# Relative to backend/, so Windows and WSL resolve to the SAME mounted directory.
DATA_DIR=data
SECRET_KEY=local-development-only
ACCESS_PASSWORD=
PUBLIC_DEPLOYMENT=0
ALLOWED_HOSTS=localhost,127.0.0.1
